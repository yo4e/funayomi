      "objective_formula": "mean_race_nll + 0.5 * lambda * sum(beta_j^2)",
      "penalized_coefficients": "all",
      "numerical_score_stabilization": "subtract_max_linear_predictor_within_each_race_before_exp",
      "post_hoc_calibration": "none"
    },
    "baseline": {

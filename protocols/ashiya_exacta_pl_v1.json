    "win_role": "diagnostic_secondary_only",
    "trifecta_role": "probability_consistency_secondary_only",
    "switching_primary_after_results": false
  },
  "estimand": {
    "name": "clean_race_conditional_exacta_probability",
    "outcomes": 30,
    "canonical_order": "permutations(entries_1_to_6,length_2)",
    "odds_required": false,
    "clean_race": {
